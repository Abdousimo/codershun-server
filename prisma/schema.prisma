generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Currencies {
  code             String  @id @db.Char(3)
  name             String
  symbol           String?
  minorUnits       Int     @default(2) @map("minor_units") @db.SmallInt
  isClientCurrency Boolean @default(false) @map("is_client_currency")
  isActive         Boolean @default(true) @map("is_active")

  @@map("currencies")
}

model FxRates {
  id            String   @id @default(uuid()) @db.Uuid
  baseCurrency  String   @map("base_currency") @db.Char(3)
  quoteCurrency String   @map("quote_currency") @db.Char(3)
  rate          Decimal  @db.Decimal(18, 8)
  rateDate      DateTime @map("rate_date") @db.Date
  source        String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([baseCurrency, quoteCurrency, rateDate, source])
  @@map("fx_rates")
}

model LegalEntities {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  legalForm           String?  @map("legal_form")
  countryCode         String   @map("country_code") @db.Char(2)
  registrationNumber  String?  @map("registration_number")
  taxId               String?  @map("tax_id")
  address             String?
  bankName            String?  @map("bank_name")
  iban                String?
  swiftBic            String?  @map("swift_bic")
  payoneerAccount     String?  @map("payoneer_account")
  defaultCurrency     String   @map("default_currency") @db.Char(3)
  invoicePrefix       String   @map("invoice_prefix")
  creditNotePrefix    String   @default("CN") @map("credit_note_prefix")
  taxMentions         Json     @default("{}") @map("tax_mentions")
  defaultVatRate      Decimal  @default(0) @map("default_vat_rate") @db.Decimal(5, 2)
  acceptsCardPayments Boolean  @default(false) @map("accepts_card_payments")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("legal_entities")
}

model Settings {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("settings")
}

model RateCardVersions {
  id                     String    @id @default(uuid()) @db.Uuid
  label                  String
  validFrom              DateTime  @map("valid_from") @db.Date
  validTo                DateTime? @map("valid_to") @db.Date
  isCurrent              Boolean   @default(false) @map("is_current")
  hoursPerMonth          Decimal   @default(160) @map("hours_per_month") @db.Decimal(6, 2)
  tmPremiumPct           Decimal   @default(15) @map("tm_premium_pct") @db.Decimal(5, 2)
  hoursPerDay            Decimal   @default(8) @map("hours_per_day") @db.Decimal(4, 2)
  partTimePricePct       Decimal   @default(55) @map("part_time_price_pct") @db.Decimal(5, 2)
  floorMarginPct         Decimal   @default(25) @map("floor_margin_pct") @db.Decimal(5, 2)
  warningMarginPct       Decimal   @default(30) @map("warning_margin_pct") @db.Decimal(5, 2)
  maxCombinedDiscountPct Decimal   @default(12) @map("max_combined_discount_pct") @db.Decimal(5, 2)
  minDedicatedMonths     Int       @default(1) @map("min_dedicated_months") @db.SmallInt
  minTmHours             Int       @default(40) @map("min_tm_hours") @db.SmallInt
  createdBy              String?   @map("created_by") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("rate_card_versions")
}

model RateCardEntries {
  id                String         @id @default(uuid()) @db.Uuid
  rateCardVersionId String         @map("rate_card_version_id") @db.Uuid
  seniority         SeniorityLevel
  minYears          Int            @map("min_years") @db.SmallInt
  maxYears          Int?           @map("max_years") @db.SmallInt
  talentNetPay      Decimal        @map("talent_net_pay") @db.Decimal(12, 2)
  targetMarginPct   Decimal        @map("target_margin_pct") @db.Decimal(5, 2)
  currency          String         @default("EUR") @db.Char(3)
  clientPrice       Decimal?       @map("client_price") @db.Decimal(12, 2)

  @@unique([rateCardVersionId, seniority])
  @@map("rate_card_entries")
}

model DiscountRules {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String
  label               String
  discountPct         Decimal  @map("discount_pct") @db.Decimal(5, 2)
  minTalents          Int?     @map("min_talents") @db.SmallInt
  minCommitmentMonths Int?     @map("min_commitment_months") @db.SmallInt
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("discount_rules")
}

model BuyoutTiers {
  id         String  @id @default(uuid()) @db.Uuid
  fromMonth  Int     @unique @map("from_month") @db.SmallInt
  toMonth    Int?    @map("to_month") @db.SmallInt
  multiplier Decimal @db.Decimal(5, 2)
  isActive   Boolean @default(true) @map("is_active")

  @@map("buyout_tiers")
}

model ReferralRewardRules {
  id                   String     @id @default(uuid()) @db.Uuid
  rewardType           RewardType @map("reward_type")
  baseAmount           Decimal    @map("base_amount") @db.Decimal(12, 2)
  perExtraTalentAmount Decimal    @default(0) @map("per_extra_talent_amount") @db.Decimal(12, 2)
  extraTalentThreshold Int?       @map("extra_talent_threshold") @db.SmallInt
  currency             String     @default("EUR") @db.Char(3)
  paidInvoicesRequired Int        @default(2) @map("paid_invoices_required") @db.SmallInt
  minClientMonths      Int        @default(3) @map("min_client_months") @db.SmallInt
  attributionDays      Int        @default(90) @map("attribution_days") @db.SmallInt
  isActive             Boolean    @default(true) @map("is_active")

  @@map("referral_reward_rules")
}

model WorkCalendars {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique
  countryCode String @map("country_code") @db.Char(2)
  workingDays Int[]  @default([]) @map("working_days")

  @@map("work_calendars")
}

model PublicHolidays {
  id          String   @id @default(uuid()) @db.Uuid
  calendarId  String   @map("calendar_id") @db.Uuid
  holidayDate DateTime @map("holiday_date") @db.Date
  name        String

  @@unique([calendarId, holidayDate])
  @@map("public_holidays")
}

model SalaryBenchmarks {
  id                 String         @id @default(uuid()) @db.Uuid
  countryCode        String         @map("country_code") @db.Char(2)
  jobRoleId          String?        @map("job_role_id") @db.Uuid
  seniority          SeniorityLevel
  yearlyEmployerCost Decimal        @map("yearly_employer_cost") @db.Decimal(12, 2)
  currency           String         @db.Char(3)
  sourceName         String         @map("source_name")
  sourceUrl          String?        @map("source_url")
  validYear          Int            @map("valid_year") @db.SmallInt

  @@unique([countryCode, jobRoleId, seniority, validYear])
  @@map("salary_benchmarks")
}

model Users {
  id                     String     @id @default(uuid()) @db.Uuid
  email                  String     @unique
  emailVerifiedAt        DateTime?  @map("email_verified_at") @db.Timestamp(6)
  passwordHash           String?    @map("password_hash")
  role                   UserRole
  firstName              String?    @map("first_name")
  lastName               String?    @map("last_name")
  avatarFileId           String?    @map("avatar_file_id") @db.Uuid
  phone                  String?
  language               UiLanguage @default(en)
  timezone               String     @default("Europe/Paris")
  twoFactorEnabled       Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecret        String?    @map("two_factor_secret")
  twoFactorRecoveryCodes String[]   @map("two_factor_recovery_codes")
  status                 UserStatus @default(active)
  lastLoginAt            DateTime?  @map("last_login_at") @db.Timestamp(6)
  lastLoginIp            String?    @map("last_login_ip")
  failedLoginCount       Int        @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil            DateTime?  @map("locked_until") @db.Timestamp(6)
  deletedAt              DateTime?  @map("deleted_at") @db.Timestamp(6)
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt              DateTime   @default(now()) @map("updated_at") @db.Timestamp(6)
  createdBy              String?    @map("created_by") @db.Uuid

  @@map("users")
}

model OauthAccounts {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model AuthTokens {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String?       @map("user_id") @db.Uuid
  email     String
  tokenHash String        @map("token_hash")
  type      AuthTokenType
  expiresAt DateTime      @map("expires_at") @db.Timestamp(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamp(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("auth_tokens")
}

model UserSessions {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sessionTokenHash String    @map("session_token_hash")
  ip               String?
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamp(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("user_sessions")
}

model StaffProfiles {
  userId             String   @id @default(uuid()) @map("user_id") @db.Uuid
  jobTitle           String?  @map("job_title")
  whatsapp           String?
  calendarUrl        String?  @map("calendar_url")
  slackUserId        String?  @map("slack_user_id")
  isReviewer         Boolean  @default(false) @map("is_reviewer")
  isExternalReviewer Boolean  @default(false) @map("is_external_reviewer")
  reviewerFee        Decimal? @map("reviewer_fee") @db.Decimal(10, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("staff_profiles")
}

model Consents {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String?     @map("user_id") @db.Uuid
  email           String?
  consentType     ConsentType @map("consent_type")
  documentVersion String?     @map("document_version")
  granted         Boolean
  ip              String?
  userAgent       String?     @map("user_agent")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("consents")
}

model GdprRequests {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String?           @map("user_id") @db.Uuid
  email        String
  requestType  GdprRequestType   @map("request_type")
  status       GdprRequestStatus @default(received)
  dueAt        DateTime          @default(dbgenerated("(now() + '30 days'::interval)")) @map("due_at") @db.Timestamp(6)
  completedAt  DateTime?         @map("completed_at") @db.Timestamp(6)
  handledBy    String?           @map("handled_by") @db.Uuid
  exportFileId String?           @map("export_file_id") @db.Uuid
  notes        String?
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime          @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("gdpr_requests")
}

model Files {
  id              String   @id @default(uuid()) @db.Uuid
  storageKey      String   @map("storage_key")
  bucket          String   @default("private")
  originalName    String   @map("original_name")
  mimeType        String   @map("mime_type")
  sizeBytes       BigInt   @map("size_bytes")
  checksumSha256  String?  @map("checksum_sha256")
  virusScanStatus String   @default("pending") @map("virus_scan_status")
  uploadedBy      String?  @map("uploaded_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("files")
}

model JobCategories {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String
  nameEn      String  @map("name_en")
  nameFr      String  @map("name_fr")
  nameAr      String? @map("name_ar")
  isOnRequest Boolean @default(false) @map("is_on_request")
  sortOrder   Int     @default(0) @map("sort_order") @db.SmallInt

  @@map("job_categories")
}

model JobRoles {
  id              String  @id @default(uuid()) @db.Uuid
  categoryId      String  @map("category_id") @db.Uuid
  slug            String
  nameEn          String  @map("name_en")
  nameFr          String  @map("name_fr")
  nameAr          String? @map("name_ar")
  isRareSkill     Boolean @default(false) @map("is_rare_skill")
  skillPremiumPct Decimal @default(0) @map("skill_premium_pct") @db.Decimal(5, 2)
  isActive        Boolean @default(true) @map("is_active")

  @@map("job_roles")
}

model Skills {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  slug       String
  categoryId String?  @map("category_id") @db.Uuid
  isRare     Boolean  @default(false) @map("is_rare")
  premiumPct Decimal  @default(0) @map("premium_pct") @db.Decimal(5, 2)
  aliases    String[] @default([])

  @@map("skills")
}

model Languages {
  code String @id
  name String

  @@map("languages")
}

model Tags {
  id    String  @id @default(uuid()) @db.Uuid
  name  String
  scope String
  color String?

  @@unique([scope, name])
  @@map("tags")
}

model Referrers {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String?        @map("user_id") @db.Uuid
  kind            ReferrerKind
  name            String
  email           String
  phone           String?
  companyId       String?        @map("company_id") @db.Uuid
  code            String
  paymentMethod   PaymentMethod? @map("payment_method")
  paymentDetails  Json           @default("{}") @map("payment_details")
  termsAcceptedAt DateTime?      @map("terms_accepted_at") @db.Timestamp(6)
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime       @default(now()) @map("updated_at") @db.Timestamp(6)
  createdBy       String?        @map("created_by") @db.Uuid

  @@map("referrers")
}

model Companies {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String
  legalName          String?       @map("legal_name")
  countryCode        String?       @map("country_code") @db.Char(2)
  industry           String?
  sizeRange          String?       @map("size_range")
  website            String?
  vatNumber          String?       @map("vat_number")
  billingAddress     String?       @map("billing_address")
  billingCity        String?       @map("billing_city")
  billingPostalCode  String?       @map("billing_postal_code")
  billingCountryCode String?       @map("billing_country_code") @db.Char(2)
  billingEmail       String?       @map("billing_email")
  legalEntityId      String?       @map("legal_entity_id") @db.Uuid
  currency           String        @default("EUR") @db.Char(3)
  status             CompanyStatus @default(lead)
  source             LeadSource?
  referralId         String?       @map("referral_id") @db.Uuid
  accountManagerId   String?       @map("account_manager_id") @db.Uuid
  workCalendarId     String?       @map("work_calendar_id") @db.Uuid
  paymentTermsDays   Int           @default(7) @map("payment_terms_days") @db.SmallInt
  isOverdueFlagged   Boolean       @default(false) @map("is_overdue_flagged")
  requestsBlockedAt  DateTime?     @map("requests_blocked_at") @db.Timestamp(6)
  requestsBlockedBy  String?       @map("requests_blocked_by") @db.Uuid
  notes              String?
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamp(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime      @default(now()) @map("updated_at") @db.Timestamp(6)
  createdBy          String?       @map("created_by") @db.Uuid

  @@map("companies")
}

model Contacts {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  firstName        String   @map("first_name")
  lastName         String?  @map("last_name")
  email            String?
  phone            String?
  jobTitle         String?  @map("job_title")
  isDecisionMaker  Boolean  @default(false) @map("is_decision_maker")
  isBillingContact Boolean  @default(false) @map("is_billing_contact")
  linkedinUrl      String?  @map("linkedin_url")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  createdBy        String?  @map("created_by") @db.Uuid

  @@map("contacts")
}

model CompanyUsers {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  isAdmin         Boolean   @default(false) @map("is_admin")
  canViewInvoices Boolean   @default(false) @map("can_view_invoices")
  invitedBy       String?   @map("invited_by") @db.Uuid
  invitedAt       DateTime? @map("invited_at") @db.Timestamp(6)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([companyId, userId])
  @@map("company_users")
}

model Leads {
  id                    String      @id @default(uuid()) @db.Uuid
  companyId             String      @map("company_id") @db.Uuid
  contactId             String?     @map("contact_id") @db.Uuid
  stage                 LeadStage   @default(new_lead)
  source                LeadSource
  heardAboutUs          String?     @map("heard_about_us")
  utmSource             String?     @map("utm_source")
  utmMedium             String?     @map("utm_medium")
  utmCampaign           String?     @map("utm_campaign")
  utmTerm               String?     @map("utm_term")
  utmContent            String?     @map("utm_content")
  landingPage           String?     @map("landing_page")
  referrerUrl           String?     @map("referrer_url")
  referralCode          String?     @map("referral_code")
  referrerId            String?     @map("referrer_id") @db.Uuid
  ownerId               String?     @map("owner_id") @db.Uuid
  estimatedMonthlyValue Decimal?    @map("estimated_monthly_value") @db.Decimal(12, 2)
  firstContactedAt      DateTime?   @map("first_contacted_at") @db.Timestamp(6)
  qualifiedAt           DateTime?   @map("qualified_at") @db.Timestamp(6)
  wonAt                 DateTime?   @map("won_at") @db.Timestamp(6)
  lostAt                DateTime?   @map("lost_at") @db.Timestamp(6)
  lostReason            LostReason? @map("lost_reason")
  lostReasonDetail      String?     @map("lost_reason_detail")
  discoveryCallAt       DateTime?   @map("discovery_call_at") @db.Timestamp(6)
  discoveryCallUrl      String?     @map("discovery_call_url")
  notes                 String?
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime    @default(now()) @map("updated_at") @db.Timestamp(6)
  createdBy             String?     @map("created_by") @db.Uuid

  @@map("leads")
}

model FormSubmissions {
  id           String     @id @default(uuid()) @db.Uuid
  formType     String     @map("form_type")
  locale       UiLanguage @default(en)
  payload      Json
  leadId       String?    @map("lead_id") @db.Uuid
  ip           String?
  userAgent    String?    @map("user_agent")
  captchaScore Decimal?   @map("captcha_score") @db.Decimal(4, 3)
  processedAt  DateTime?  @map("processed_at") @db.Timestamp(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("form_submissions")
}

model Talents {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String?         @map("user_id") @db.Uuid
  firstName           String          @map("first_name")
  lastName            String          @map("last_name")
  email               String
  phone               String?
  whatsapp            String?
  city                String?
  countryCode         String          @default("DZ") @map("country_code") @db.Char(2)
  headline            String?
  summary             String?
  categoryId          String?         @map("category_id") @db.Uuid
  jobRoleId           String?         @map("job_role_id") @db.Uuid
  seniority           SeniorityLevel?
  yearsExperience     Decimal?        @map("years_experience") @db.Decimal(4, 1)
  linkedinUrl         String?         @map("linkedin_url")
  githubUrl           String?         @map("github_url")
  portfolioUrl        String?         @map("portfolio_url")
  expectedPay         Decimal?        @map("expected_pay") @db.Decimal(12, 2)
  currentPay          Decimal?        @map("current_pay") @db.Decimal(12, 2)
  agreedPay           Decimal?        @map("agreed_pay") @db.Decimal(12, 2)
  payCurrency         String          @default("EUR") @map("pay_currency") @db.Char(3)
  availabilityDate    DateTime?       @map("availability_date") @db.Date
  noticePeriodDays    Int?            @map("notice_period_days") @db.SmallInt
  timeSharePct        Int             @default(100) @map("time_share_pct") @db.SmallInt
  vettingStage        VettingStage    @default(applied) @map("vetting_stage")
  status              TalentStatus    @default(in_vetting)
  vettingScore        Decimal?        @map("vetting_score") @db.Decimal(5, 2)
  vettedAt            DateTime?       @map("vetted_at") @db.Timestamp(6)
  vettedBy            String?         @map("vetted_by") @db.Uuid
  rejectedAt          DateTime?       @map("rejected_at") @db.Timestamp(6)
  rejectCategory      RejectCategory? @map("reject_category")
  rejectReason        String?         @map("reject_reason")
  canReapplyAfter     DateTime?       @map("can_reapply_after") @db.Date
  showcaseOptIn       Boolean         @default(false) @map("showcase_opt_in")
  showcaseConsentAt   DateTime?       @map("showcase_consent_at") @db.Timestamp(6)
  showcasePublished   Boolean         @default(false) @map("showcase_published")
  publicSlug          String?         @map("public_slug")
  publicDisplayName   String?         @map("public_display_name")
  photoFileId         String?         @map("photo_file_id") @db.Uuid
  photoConsentAt      DateTime?       @map("photo_consent_at") @db.Timestamp(6)
  showIndicativePrice Boolean         @default(false) @map("show_indicative_price")
  payoutMethod        PaymentMethod?  @map("payout_method")
  payoutCurrency      String?         @map("payout_currency") @db.Char(3)
  payoutDetails       Json            @default("{}") @map("payout_details")
  isBlacklisted       Boolean         @default(false) @map("is_blacklisted")
  blacklistReason     String?         @map("blacklist_reason")
  lastActivityAt      DateTime?       @map("last_activity_at") @db.Timestamp(6)
  profileCompleteness Int             @default(0) @map("profile_completeness") @db.SmallInt
  recruiterId         String?         @map("recruiter_id") @db.Uuid
  mergedIntoId        String?         @map("merged_into_id") @db.Uuid
  anonymisedAt        DateTime?       @map("anonymised_at") @db.Timestamp(6)
  deletedAt           DateTime?       @map("deleted_at") @db.Timestamp(6)
